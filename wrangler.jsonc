{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Tên Worker trên Cloudflare. PHẢI khớp đúng Worker đang phục vụ tên miền,
  // nếu không `wrangler deploy` sẽ tạo ra một Worker THỨ HAI hoàn toàn mới:
  // không có secret (ADMIN_PASSWORD, SESSION_SECRET), không gắn tên miền nào,
  // nên deploy báo thành công mà trang thật thì không hề đổi — rất khó nhận ra.
  //
  // Worker cũ tên `pkmm-online` đã được đổi tên thành `phamkhanhminhman` trên
  // Cloudflare khi chuyển tên miền, nhưng file này chưa cập nhật theo.
  "name": "phamkhanhminhman",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Chỉ những đường dẫn này đi qua Worker; mọi thứ khác (ảnh, JS, CSS, trang
    // about...) đi thẳng tới Asset Worker, không tốn một lần gọi Worker nào.
    //
    // `/about` và `/projects/*` được thêm vào khi làm nhật ký lượt xem: Worker
    // chỉ ghi được lượt truy cập mà nó NHÌN THẤY, nên trang nào không nằm
    // trong danh sách này sẽ không bao giờ xuất hiện trong /admin/visitors.
    // Cố ý KHÔNG khai "/*": làm vậy thì mỗi file ảnh, CSS, JS cũng tốn một
    // lượt gọi Worker và đẻ ra hàng chục hàng rác cho mỗi lần mở trang.
    "run_worker_first": [
      // Cả /api/*, không chỉ /api/admin/*: /api/pulse là nơi trình duyệt báo
      // về thông tin máy và tương tác. Thiếu dòng này thì lượt POST đó rơi vào
      // Asset Worker và bị trả 405 — Worker không bao giờ thấy nó.
      "/api/*",
      "/",
      "/vi",
      "/vi/*",
      "/blog/*",
      "/about",
      "/projects/*",
      "/rss.xml",
      "/sitemap.xml"
    ]
  },
  // id ghim tay: bản wrangler 4.125.0 không tự ghi id ngược lại sau
  // provision — deploy tiếp mà thiếu id có thể tạo namespace thứ hai và bỏ
  // rơi dữ liệu admin đã có trong namespace này.
  "kv_namespaces": [
    { "binding": "POST_META", "id": "3d764690bc6c492982b4b627f83ee088" }
  ],
  // Nhật ký lượt truy cập (bảng `visits`). Dùng D1 chứ không phải KV vì cần
  // truy vấn theo khoảng thời gian và gộp theo IP — xem migrations/0001_visits.sql.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phamkhanhminhman",
      "database_id": "2e8ea837-b1df-40b3-8e07-caa5cb511806"
    }
  ],
  // Chặn dò mật khẩu trang quản trị: 5 lần thử mỗi phút cho mỗi IP.
  //
  // Rate limiting binding chạy ngay trong runtime của Worker, không tính vào
  // hạn mức D1/KV và không cần gói trả phí. `namespace_id` là số do mình tự
  // đặt, chỉ cần duy nhất trong phạm vi Worker này.
  //
  // Ngưỡng 5/phút: đủ rộng cho người gõ nhầm vài lần, nhưng biến việc thử một
  // mật khẩu 8 ký tự từ chuyện vài giờ thành chuyện nhiều năm.
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Domain chinh chuyen sang phamkhanhminhman.com - pkmm.online van tro vao
  // cung Worker nay qua route cu (pkmm.online/*, www.pkmm.online/*) nen
  // link cu khong chet, chi doi SITE_URL de canonical/OG tro ve ten mien moi.
  "routes": [
    { "pattern": "phamkhanhminhman.com", "custom_domain": true },
    { "pattern": "www.phamkhanhminhman.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
